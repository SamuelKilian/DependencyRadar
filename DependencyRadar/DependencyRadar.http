@DependencyRadar_HostAddress = http://localhost:5127

### Check API health
GET {{DependencyRadar_HostAddress}}/api/health
Accept: application/json

### Submit packages for scanning
POST {{DependencyRadar_HostAddress}}/api/scans
Content-Type: application/json

{
    "packages": [
        {
            "name": "Newtonsoft.Json",
            "version": "13.0.1"
        },
        {
            "name": "Serilog",
            "version": "3.1.1"
        }
    ]
}

### Test invalid package
POST {{DependencyRadar_HostAddress}}/api/scans
Content-Type: application/json

{
    "packages": [
        {
            "name": "",
            "version": "13.0.1"
        },
        {
            "name": "Serilog",
            "version": "   "
        }
    ]
}

### Test 1 - Valid packages
POST {{DependencyRadar_HostAddress}}/api/scans
Content-Type: application/json

{
    "packages": [
        { "name": "Newtonsoft.Json", "version": "13.0.1" },
        { "name": "Serilog", "version": "3.1.1" }
    ]
}

### Test 2 - Missing name
POST {{DependencyRadar_HostAddress}}/api/scans
Content-Type: application/json

{
    "packages": [
        { "name": "", "version": "13.0.1" }
    ]
}

### Test 3 - Empty list
POST {{DependencyRadar_HostAddress}}/api/scans
Content-Type: application/json

{
    "packages": []
}

### Test 4 - Null package
POST {{DependencyRadar_HostAddress}}/api/scans
Content-Type: application/json

{
    "packages": [
        null
    ]
}

### Test 5 - Direct OSV API
POST https://api.osv.dev/v1/query
Content-Type: application/json

{
    "package": {
        "name": "Newtonsoft.Json",
        "ecosystem": "NuGet"
    },
    "version": "13.0.1"
}

### Test 6 - Known vulnerable package
POST {{DependencyRadar_HostAddress}}/api/scans
Content-Type: application/json

{
    "packages": [
        {
            "name": "Newtonsoft.Json",
            "version": "9.0.1"
        }
    ]
}

### Test 5A - Missing package name
POST {{DependencyRadar_HostAddress}}/api/scans
Content-Type: application/json

{
    "packages": [
        {
            "name": "",
            "version": "9.0.1"
        }
    ]
}

### Test 5B - Missing package version
POST {{DependencyRadar_HostAddress}}/api/scans
Content-Type: application/json

{
    "packages": [
        {
            "name": "Newtonsoft.Json",
            "version": ""
        }
    ]
}

